# ---------------------------------------------------------------------------
# E-Courtier — backend. Copier en .env (jamais commité) et adapter.
# ---------------------------------------------------------------------------
DJANGO_ENV=development                 # development | test | production — toute autre valeur est refusée
# Module de paramètres : déduit de DJANGO_ENV (development → config.settings.dev, production → config.settings.prod).
# Ne le forcer que pour un besoin précis ; avec DJANGO_ENV=production, seul config.settings.prod est accepté.
# DJANGO_SETTINGS_MODULE=config.settings.prod
# Fichier .env à charger (par défaut backend/.env) ; un chemin inexistant désactive le chargement.
# DJANGO_DOTENV_FILE=
DJANGO_SECRET_KEY=                     # OBLIGATOIRE en production (≥ 40 caractères aléatoires) : python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL.
# Neon — application : URL POOLED (hôte contenant « -pooler »)
#   postgresql://<rôle>:<mot-de-passe>@ep-xxxx-pooler.<région>.aws.neon.tech/ecourtier?sslmode=require&channel_binding=require
# En production, une base distante sans sslmode=require est refusée au démarrage.
DATABASE_URL=postgres://ecourtier:ecourtier@localhost:5432/ecourtier
# Neon — migrations uniquement : URL DIRECTE (même hôte SANS « -pooler »), lue par build.sh.
# DATABASE_URL_DIRECT=
DB_CONN_MAX_AGE=60
# Base utilisée par pytest (sinon SQLite en mémoire ; les tests de concurrence sont alors ignorés).
# pytest CRÉE puis SUPPRIME cette base : PostgreSQL local uniquement. Une URL distante est refusée,
# sauf branche Neon jetable avec ALLOW_REMOTE_TEST_DATABASE=true. Jamais la base de production.
TEST_DATABASE_URL=postgres://ecourtier:ecourtier@localhost:5432/ecourtier_test
# ALLOW_REMOTE_TEST_DATABASE=false

# Frontend autorisé (CORS + CSRF) et URL utilisée dans les e-mails.
# En production : obligatoires, en https:// uniquement (sinon refus de démarrer). DJANGO_ALLOWED_HOSTS aussi, sans « * ».
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Cookie de rafraîchissement : Lax si front et API partagent le site, None (+ HTTPS) s'ils sont sur des domaines distincts
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Règles métier
DOSSIER_FEE_XOF=5000
SALE_DEPOSIT_PERCENT=10

# Paiement Wave Business : lien marchand fourni par Wave (laisser vide = paiement Wave désactivé)
WAVE_PAYMENT_LINK=
# Simulation de paiement : true uniquement en local / démo. Refusée au démarrage en production.
PAYMENT_SIMULATION_ENABLED=true

# Assistant IA. LLM_PROVIDER : gemini | groq | rules (rules = aucune IA, analyse déterministe gratuite)
LLM_PROVIDER=rules
LLM_MODEL=                             # ex. gemini-2.5-flash-lite ou llama-3.1-8b-instant — vérifier la disponibilité sur votre compte
LLM_API_KEY=                           # clé du fournisseur, jamais côté React ni dans Git
LLM_GEMINI_DISABLE_THINKING=true       # désactive le « raisonnement » des modèles Flash 2.5 (consomme des jetons)
LLM_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=256
LLM_MAX_RETRIES=1
LLM_COOLDOWN_SECONDS=60
ASSISTANT_GLOBAL_DAILY_REQUESTS=120    # demandes envoyées au LLM / jour (au-delà : mode règles)
ASSISTANT_GLOBAL_DAILY_PROVIDER_CALLS=200
ASSISTANT_USER_DAILY_REQUESTS=20
ASSISTANT_ANON_DAILY_REQUESTS=10
ASSISTANT_HISTORY_MESSAGES=4
ASSISTANT_MAX_MESSAGE_CHARS=500
ASSISTANT_RESULTS_LIMIT=6

# Limites de débit (format DRF)
THROTTLE_ANON=300/hour
THROTTLE_USER=2000/hour
THROTTLE_AUTH=10/minute
THROTTLE_REFRESH=60/minute
THROTTLE_REGISTER=10/hour
THROTTLE_ASSISTANT=8/minute
THROTTLE_REPORTS=10/day
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_UPLOADS=60/hour

# HTTPS (production uniquement)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=2592000

# Stockage des fichiers : local (disque) ou s3 (R2, B2, Supabase… ; installer requirements-s3.txt)
STORAGE_BACKEND=local
MEDIA_URL=/media/
MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_PUBLIC_DOMAIN=
MAX_PHOTO_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=8
MAX_PHOTOS_PER_LISTING=12

# Notifications
SMS_BACKEND=apps.notifications.channels.LoggingSMSBackend   # journalise sans envoyer (aucun fournisseur SMS configuré)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=E-Courtier <no-reply@example.sn>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

LOG_LEVEL=INFO
